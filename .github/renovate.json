{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		":semanticPrefixFixDepsChoreOthers",
		":ignoreModulesAndTests",
		"group:all",
		"workarounds:all",
		":gitSignOff"
	],
	"branchConcurrentLimit": 0,
	"forkProcessing": "enabled",
	"packageRules": [
		{
			"matchManagers": ["npm"],
			"enabled": false
		},
		{
			"matchManagers": ["gomod"],
			"matchDepTypes": ["replace"],
			"enabled": false
		},
		{
			"matchManagers": ["gomod"],
			"matchDepTypes": ["golang"],
			"enabled": false
		},
		{
			"description": "CI pins old Go and Deno releases on purpose to test the oldest versions esbuild supports.",
			"matchManagers": ["github-actions"],
			"matchDepNames": ["go", "deno"],
			"enabled": false
		}
	]
}
